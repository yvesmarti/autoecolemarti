# Claude Code ignore file for Auto-École Marti
# This file helps prevent timeouts by excluding large/binary files and system directories

# SVG road signs database (294 files, data only)
quizz/panneaux/
# Gros fichier de données statiques (le motif doit porter le chemin complet,
# sans quoi il ne correspond à rien)
quizz/panneaux_data.js

# Font files (binary, not modified during development)
fonts/

# System & IDE files
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
*~

# Node/build artifacts
node_modules/
dist/
build/
.DS_Store

# Captures d'écran de comparaison (npm run shot)
.captures/

# Log files
*.log
logs/

# Temporary files
*.tmp
*.bak
.cache/

# Environment files (if any)
.env
.env.local
.env.*.local
