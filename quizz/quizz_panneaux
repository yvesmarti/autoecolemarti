// ── ÉTAT DU QUIZ ──────────────────────────────────────────────────────
let questions    = [];
let currentIndex = 0;
let scoreOk      = 0;
let scoreKo      = 0;
let answered     = false;

// ── UTILITAIRES ───────────────────────────────────────────────────────
function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function getCategoryLabel(cat) {
  const labels = {
    danger:        "⚠️ Danger",
    interdiction:  "🚫 Interdiction",
    indication:    "🔵 Indication / Obligation",
    service:       "🛎️ Service",
    localisation:  "📍 Localisation",
    fin_obligation:"⚪ Fin d'obligation",
  };
  return labels[cat] || cat;
}

function getDistractors(correct) {
  // Cherche dans la même catégorie en priorité, puis dans le même type, sinon autre
  let pool = panneauxData.filter(p =>
    p.code !== correct.code &&
    p.categorie === correct.categorie
  );
  if (pool.length < CHOICES_PER_Q - 1) {
    pool = panneauxData.filter(p => p.code !== correct.code);
  }
  return shuffle(pool).slice(0, CHOICES_PER_Q - 1);
}

// ── DÉMARRAGE ─────────────────────────────────────────────────────────
function startQuiz() {
  questions    = shuffle(panneauxData).slice(0, TOTAL_QUESTIONS);
  currentIndex = 0;
  scoreOk      = 0;
  scoreKo      = 0;

  document.getElementById("results-screen").classList.remove("show");
  document.getElementById("question-card").style.display = "flex";
  document.getElementById("progress-wrap") && null;

  updateScoreboard();
  renderQuestion();
}

// ── RENDU QUESTION ────────────────────────────────────────────────────
function renderQuestion() {
  answered = false;
  const q = questions[currentIndex];

  // Progress
  const pct = (currentIndex / TOTAL_QUESTIONS) * 100;
  document.getElementById("progress-fill").style.width = pct + "%";
  document.getElementById("q-label").textContent = `Question ${currentIndex + 1} / ${TOTAL_QUESTIONS}`;
  document.getElementById("q-category").textContent = getCategoryLabel(q.categorie);

  // Image
  const img = document.getElementById("sign-img");
  img.src = IMAGE_BASE_PATH + q.code + ".svg";
  img.alt = "Panneau " + q.code;
  document.getElementById("sign-code").textContent = "Code : " + q.code;

  // Choix (bonne réponse + 3 distracteurs, mélangés)
  const distractors = getDistractors(q);
  const choices = shuffle([q, ...distractors]);

  const grid = document.getElementById("answers-grid");
  grid.innerHTML = "";
  const letters = ["A", "B", "C", "D"];

  choices.forEach((choice, i) => {
    const btn = document.createElement("button");
    btn.className = "answer-btn";
    btn.innerHTML = `<span class="answer-letter">${letters[i]}</span>${choice.nom}`;
    btn.dataset.code = choice.code;
    btn.addEventListener("click", () => handleAnswer(btn, choice.code === q.code, q));
    grid.appendChild(btn);
  });

  // Reset feedback / bouton
  const fb = document.getElementById("feedback");
  fb.className = "feedback";
  fb.textContent = "";

  document.getElementById("btn-next").classList.remove("show");

  // Animation de la carte
  const card = document.getElementById("question-card");
  card.style.animation = "none";
  requestAnimationFrame(() => { card.style.animation = ""; });
}

// ── GESTION RÉPONSE ───────────────────────────────────────────────────
function handleAnswer(btn, isCorrect, panneau) {
  if (answered) return;
  answered = true;

  const allBtns = document.querySelectorAll(".answer-btn");
  allBtns.forEach(b => {
    b.disabled = true;
    if (b.dataset.code === panneau.code) b.classList.add("correct");
  });

  const fb = document.getElementById("feedback");

  if (isCorrect) {
    scoreOk++;
    btn.classList.add("correct");
    fb.className = "feedback correct show";
    fb.innerHTML = `✅ Bonne réponse ! <strong>${panneau.nom}</strong> — ${getDescription(panneau.code)}`;
  } else {
    scoreKo++;
    btn.classList.add("wrong");
    fb.className = "feedback wrong show";
    fb.innerHTML = `❌ Raté ! La bonne réponse était <strong>${panneau.nom}</strong>. ${getDescription(panneau.code)}`;
  }

  updateScoreboard();
  document.getElementById("btn-next").classList.add("show");
}

