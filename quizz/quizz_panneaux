// ── QUESTION SUIVANTE ─────────────────────────────────────────────────
function nextQuestion() {
  currentIndex++;
  if (currentIndex >= TOTAL_QUESTIONS) {
    showResults();
  } else {
    renderQuestion();
  }
}

// ── RÉSULTATS ─────────────────────────────────────────────────────────
function showResults() {
  document.getElementById("question-card").style.display = "none";
  document.getElementById("progress-fill").style.width = "100%";

  const pct = Math.round((scoreOk / TOTAL_QUESTIONS) * 100);
  let msg = "";
  if (pct === 100) msg = "Score parfait ! Vous êtes prêt(e) pour l'examen 🎉";
  else if (pct >= 70) msg = "Très bien ! Continuez à vous entraîner pour viser le sans-faute.";
  else if (pct >= 50) msg = "Pas mal, mais il reste des notions à réviser. Recommencez !";
  else msg = "Il faut reprendre l'étude des panneaux. Courage, vous y arriverez !";

  document.getElementById("final-score").textContent = scoreOk;
  document.getElementById("final-out-of").textContent = `/ ${TOTAL_QUESTIONS}`;
  document.getElementById("results-message").textContent = msg;
  document.getElementById("results-screen").classList.add("show");
}

// ── SCORE DISPLAY ─────────────────────────────────────────────────────
function updateScoreboard() {
  document.getElementById("score-correct").textContent = scoreOk;
  document.getElementById("score-wrong").textContent   = scoreKo;
}

// ── LANCEMENT ─────────────────────────────────────────────────────────
startQuiz();
</script>
